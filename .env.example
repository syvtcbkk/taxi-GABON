# Copy this file to .env and fill values before running the app locally
# Do NOT commit your .env with real secrets to version control.

# ========== SECURITY SETTINGS ==========

# Development Mode (ONLY set to true locally for testing)
# WARNING: Never use DEV_MODE=true in production
DEV_MODE=false

# ========== STRIPE CONFIGURATION ==========

# Stripe (test keys from https://dashboard.stripe.com)
STRIPE_SECRET=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ========== DATABASE CONFIGURATION ==========

# Database connection (if using env variables instead of db.php defaults)
#DB_HOST=127.0.0.1
#DB_NAME=taxi_gabon
#DB_USER=root
#DB_PASSWORD=

# ========== EMAIL CONFIGURATION ==========

# SMTP settings for PHPMailer
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@taxigabon.ga
MAIL_FROM_NAME=Taxi Gabon

# ========== APPLICATION SETTINGS ==========

APP_ENV=local
APP_DEBUG=true

# ========== LOGGING ==========

LOG_LEVEL=INFO
